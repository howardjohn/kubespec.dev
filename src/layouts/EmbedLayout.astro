---
type Props = {
  title: string;
  description: string;
  canonicalUrl: string;
};

const { title, description, canonicalUrl } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0.75rem;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        font-size: 14px;
        line-height: 1.5;
        color: #111827;
        background: #fff;
      }
      h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 0.25rem;
      }
      .api-version {
        font-size: 0.875rem;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 0.25rem;
      }
      .scope-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.75rem;
        color: #6b7280;
        border: 1px solid #e5e7eb;
        border-radius: 0.375rem;
        padding: 0.125rem 0.5rem;
        margin-bottom: 0.5rem;
      }
      .description {
        font-size: 0.875rem;
        color: #6b7280;
        margin: 0.5rem 0 1rem;
        white-space: pre-wrap;
        max-width: 48rem;
      }
      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .prop-tree {
        font-family: ui-monospace, monospace;
        font-size: 0.8125rem;
      }
      .prop-tree > li + li {
        margin-top: 0.125rem;
      }
      .prop-tree.nested {
        margin-left: 1rem;
        padding-left: 0.5rem;
        border-left: 2px solid #e5e7eb;
      }
      details > summary {
        list-style: none;
        cursor: pointer;
        display: inline-flex;
        align-items: baseline;
        gap: 0.25rem;
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
        font-weight: 600;
      }
      details > summary::-webkit-details-marker {
        display: none;
      }
      details > summary:hover {
        background: #f3f4f6;
      }
      .prop-name {
        cursor: default;
      }
      .prop-name.has-desc {
        cursor: pointer;
      }
      .required {
        color: #dc2626;
        font-size: 0.6875rem;
        margin-right: 0.125rem;
      }
      .type-string {
        color: #c2410c;
      }
      .type-boolean {
        color: #1d4ed8;
      }
      .type-integer {
        color: #0369a1;
      }
      .type-object,
      .type-time {
        color: #7c3aed;
      }
      .type-complex {
        color: #9d174d;
      }
      .type-other {
        color: #065f46;
      }
      .prop-desc {
        margin: 0.25rem 0 0.5rem 0.25rem;
        font-size: 0.75rem;
        font-weight: 400;
        white-space: pre-wrap;
        max-width: 48rem;
        color: #374151;
        font-family: inherit;
      }
      .footer-link {
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid #e5e7eb;
        font-size: 0.75rem;
        color: #6b7280;
      }
      .footer-link a {
        color: #2563eb;
        text-decoration: none;
      }
      .footer-link a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <slot />
    <div class="footer-link">
      View full docs on <a href={canonicalUrl} target="_blank"
        >kubespec.dev ↗</a
      >
    </div>
  </body>
</html>
