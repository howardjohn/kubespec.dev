---
import EmbedLayout from "@layouts/EmbedLayout.astro";
import EmbedPropertyTree from "@components/EmbedPropertyTree.astro";
import {
  listProjects,
  findProject,
  listAllResources,
  findResource,
  parseGVKRef,
} from "@lib/kube";

export async function getStaticPaths() {
  const projects = await listProjects();

  const tasks = projects.map(async (project) => {
    const tag = project.tags[0];
    const resources = await listAllResources(project.slug, tag);
    return resources.map((resource) => ({
      params: {
        project: project.slug,
        gvkRef: [
          resource.gvk.group,
          resource.gvk.version,
          resource.gvk.kind,
        ].join("/"),
      },
    }));
  });

  return (await Promise.all(tasks)).flat();
}

const { project: projectSlug, gvkRef } = Astro.params;

const project = await findProject(projectSlug);
const tag = project.tags[0];
const gvk = parseGVKRef(gvkRef);
const apiVersion = gvk.group ? `${gvk.group}/${gvk.version}` : gvk.version;
const resource = await findResource(project.slug, tag, gvk);

if (!resource) {
  throw new Error(
    `Resource not found in ${project.slug}: ${apiVersion}/${gvk.kind}`
  );
}

const canonicalPath =
  projectSlug === "kubernetes"
    ? `/${gvkRef}`
    : `/${projectSlug}/${gvkRef}`;
const canonicalUrl = `https://kubespec.dev${canonicalPath}`;
---

<EmbedLayout
  title={`${gvk.kind} (${apiVersion}) — ${project.name}`}
  description={`${project.name} API reference for ${gvk.kind} ${apiVersion}`}
  canonicalUrl={canonicalUrl}
>
  <div class="api-version">{apiVersion}</div>
  <div class="scope-badge">
    {
      resource.scope === "Namespaced"
        ? "Namespaced Resource"
        : "Cluster-scoped Resource"
    }
  </div>
  <h1>{gvk.kind}</h1>
  {
    resource.definition.description && (
      <pre class="description">{resource.definition.description}</pre>
    )
  }

  <EmbedPropertyTree
    scope={resource.scope}
    definition={resource.definition}
    level={0}
  />
</EmbedLayout>
